# Copy to .env for local development: cp .env.example .env

# --- server (apps/server) ---
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins, or * for any.
CORS_ORIGIN=http://localhost:5173
# true => the API process also serves apps/web/dist (single-service deploy).
SERVE_CLIENT=false
LOG_LEVEL=info

# --- web (apps/web) ---
# Leave empty to use same-origin requests (dev proxy / single-service deploy).
# Set to the public API URL for a split deploy, e.g. https://memory-lane-api.up.railway.app
VITE_API_URL=
